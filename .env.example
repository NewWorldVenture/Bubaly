# ============================================================
# FamilyOS — Environment Variables Reference
# Copy to .env.local and fill in your values.
# DO NOT commit .env.local — and never put real secrets in this file.
# This is a template only; every value below is a placeholder.
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- App URL ----
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- Stripe ----
# Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_publishable_key
# Webhook secret: https://dashboard.stripe.com/webhooks (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe price IDs per tier (Family Basic $9.99/mo·$99.99/yr, Family+ $24.99/mo·$249.99/yr)
STRIPE_PRICE_BASIC_MONTHLY=price_your_basic_monthly_id
STRIPE_PRICE_BASIC_ANNUAL=price_your_basic_annual_id
STRIPE_PRICE_PLUS_MONTHLY=price_your_plus_monthly_id
STRIPE_PRICE_PLUS_ANNUAL=price_your_plus_annual_id
# Legacy single-product price IDs (optional) — used as a fallback for Basic if
# the per-tier vars above aren't set, so existing subscriptions keep working.
STRIPE_PRICE_FAMILY_MONTHLY=price_your_legacy_monthly_id
STRIPE_PRICE_FAMILY_ANNUAL=price_your_legacy_annual_id

# ---- AI ----
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# ---- Email (Resend) ----
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Verified sender. Must be an address on a domain you've verified in Resend
# (https://resend.com/domains). For quick testing use: FamilyOS <onboarding@resend.dev>
EMAIL_FROM=FamilyOS <notifications@yourdomain.com>
# Inbox that receives website contact-form submissions
CONTACT_INBOX=hello@yourdomain.com
# Shared secret guarding the internal welcome-email endpoint (any random string)
INTERNAL_SECRET=generate_a_random_string
# Resend webhook signing secret (whsec_...) — required to record marketing email
# opens/clicks/bounces. Create at https://resend.com/webhooks → endpoint /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
# Optional: dedicated secret for signing marketing unsubscribe links
# (falls back to INTERNAL_SECRET). Generate: openssl rand -hex 32
MARKETING_UNSUB_SECRET=

# ---- Google OAuth (Sign-in + Calendar sync) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs: https://your-project-ref.supabase.co/auth/v1/callback
#   and https://your-app.vercel.app/api/google/calendar/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---- Sync Platform ----
# 32-byte symmetric key that encrypts provider OAuth tokens before they touch the
# database (AES-256-GCM, see lib/sync/crypto.ts). REQUIRED to connect any account —
# without it, token storage fails closed rather than persisting plaintext.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TOKEN_KEY=

# Google two-way sync (Calendar events + Tasks). Use a DEDICATED OAuth client,
# separate from the login/read-only GOOGLE_* pair above. Register the redirect
# URI on that client in the Google console. Falls back to GOOGLE_CLIENT_ID/SECRET
# and an origin-derived redirect if these are unset.
GOOGLE_SYNC_CLIENT_ID=
GOOGLE_SYNC_CLIENT_SECRET=
GOOGLE_SYNC_REDIRECT_URI=https://www.theagoras.com/api/sync/google/callback
# Scopes (space-separated within each). Least-privilege: events read/write +
# calendar list read + tasks. openid+email are always added for the account email.
GOOGLE_SYNC_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
GOOGLE_SYNC_CALENDAR_READONLY_SCOPE=https://www.googleapis.com/auth/calendar.readonly
GOOGLE_SYNC_TASKS_SCOPES=https://www.googleapis.com/auth/tasks

# Microsoft Graph (Outlook Calendar, Microsoft To Do, OneNote)
# Register an app at https://entra.microsoft.com → App registrations.
# Redirect URI: https://your-app.vercel.app/api/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Vercel Cron ----
# Random secret used to authenticate Vercel's cron pings — generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Push / Mobile ----
# Web Push (installed PWA) uses VAPID keys. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the browser; the PRIVATE key stays server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@theagoras.com

# Native push (iOS/Android via Capacitor) is delivered through FCM. Set the FCM
# server key to enable native delivery; without it, native sends are skipped
# (never silently dropped). APNs is routed via FCM's Apple integration.
FCM_SERVER_KEY=

# Capacitor native shells load this hosted URL (defaults to production). Point at
# a LAN dev server (e.g. http://192.168.1.20:3000) for on-device development.
CAP_SERVER_URL=https://www.theagoras.com
