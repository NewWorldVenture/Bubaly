# ============================================================
# Bubaly — Environment Variables Reference
# Copy to .env.local and fill in your values.
# DO NOT commit .env.local — and never put real secrets in this file.
# This is a template only; every value below is a placeholder.
#
# Conventions:
#   - Every variable the app, the build, or an operator script reads is
#     declared here exactly once (the mobile app's are in mobile/.env.example).
#     docs/architecture/environment-registry.md lists every reader, generated
#     from the code by `npm run env:registry`.
#   - A `# NAME=` line is optional: leave it commented unless you need it.
#   - [secret] marks credential, signing or encryption material. Keep it
#     server-side and out of any NEXT_PUBLIC_* / EXPO_PUBLIC_* variable.
#   - Variables read only by tests or bound only by CI workflows are listed in
#     the registry and need no line here; the few a developer sets by hand to
#     run the e2e suite are in the test-only block below.
# ============================================================

# ---- Supabase ----
# Project URL. Every Supabase client, server and browser, is built from it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon (publishable) key for the browser and server clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# [secret] Service-role key. REQUIRED server-side: createServiceClient()
# (lib/supabase/server.ts) passes it straight to supabase-js with no guard, so
# with it unset every caller that does not check first throws. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Legacy seed scripts (explicitly non-production) ----
# Required by scripts/seed*.mjs. These scripts use the service role and may
# mutate family-scoped records; production is intentionally rejected.
# Which environment the seed targets; scripts/seed-client.mjs checks an allowlist.
SEED_ENVIRONMENT=local
# The family the seed writes to (a UUID).
SEED_FAMILY_ID=00000000-0000-4000-8000-000000000000
# Must equal SEED_FAMILY_ID, as a confirmation of the target.
SEED_CONFIRM_FAMILY_ID=00000000-0000-4000-8000-000000000000
# The user recorded as creator of seeded rows (read by scripts/seed-client.mjs).
SEED_CREATED_BY_USER_ID=00000000-0000-4000-8000-000000000000
# Alias the seed scripts accept when NEXT_PUBLIC_SUPABASE_URL is unset
# (scripts/seed-client.mjs, scripts/seed-personas.mjs). The app never reads it.
# SUPABASE_URL=

# ---- App URL ----
# Both must be the CANONICAL custom domain in production (https://www.bubaly.com),
# never the generated *.vercel.app alias: that alias is tied to the Vercel project
# NAME and is released whenever the project is renamed.
# Base for OAuth callbacks, Twilio webhooks, and billing return URLs. Readers
# do not agree on what happens when it is unset: appBaseUrl()
# (lib/server/app-url.ts) silently returns https://www.bubaly.com for an
# unset, blank or malformed value, while the billing routes fall back to the
# request's Origin header and then http://localhost:3000. Always set it.
NEXT_PUBLIC_APP_URL=https://www.bubaly.com
# Site origin for marketing URLs and provider sync. REQUIRED in production for
# Secure auth cookies: the Supabase and recovery cookies carry `Secure` only
# when this is an https URL (lib/supabase/server.ts, lib/auth/recovery-cookies.ts,
# isSecureOrigin in lib/auth/session.ts); unset, the attribute is omitted.
# Provider sync throws when it is unset (lib/marketing/provider-sync.ts).
NEXT_PUBLIC_SITE_URL=https://www.bubaly.com

# ---- Access and optional platform features ----
# Extra super-admin emails, comma-separated (spaces are trimmed, case is
# ignored). They are added to the built-in allowlist in
# lib/constants/super-admins.ts; unset or blank adds none.
SUPER_ADMIN_EMAILS=
# [secret] Signs child (kid) sign-in. Unset or left as this placeholder, kid
# sign-in is refused (configuredSecret in app/(auth)/actions.ts).
CHILD_LOGIN_SECRET=generate_a_random_string
# [secret] Authorizes the internal Guardian escalation call. Falls back to
# CRON_SECRET when unset (app/api/guardian/escalate/route.ts).
GUARDIAN_INTERNAL_SECRET=generate_a_random_string

# ---- Stripe ----
# Keys: https://dashboard.stripe.com/apikeys
# [secret] Stripe API secret key. A key saved in the admin Stripe settings is
# used first where lib/stripe/settings.ts is consulted.
STRIPE_SECRET_KEY=sk_live_or_test_your_secret_key
# Stripe publishable key for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_publishable_key
# [secret] Webhook secret: https://dashboard.stripe.com/webhooks (endpoint:
# /api/webhooks/stripe). The webhook uses a secret saved in admin Stripe
# settings first, then this. Unset, blank or left as this placeholder, the
# webhook answers 503 before verifying anything (configuredSecret in
# lib/stripe/settings.ts); it is also the money webhook's fallback.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# [secret] Bubaly Money (Issuing/Treasury/Connect) webhook — SEPARATE endpoint
# from billing: point a second Stripe webhook at /api/webhooks/money and put its
# secret here. Falls back to STRIPE_WEBHOOK_SECRET; with neither usable, the
# endpoint answers 503 (app/api/webhooks/money/route.ts).
STRIPE_MONEY_WEBHOOK_SECRET=

# Stripe price IDs per tier (USD): Family Basic $12.04/mo or $119.88/yr;
# Family+ $30.11/mo or $299.88/yr. Annual billing is equivalent to $9.99/mo
# or $24.99/mo respectively (about 17% less than paying monthly).
# Current live IDs and rollout status: docs/runbooks/family-pricing.md.
# Test environments must use matching test-mode prices; do not copy live secrets.
# Price ID for Family Basic, monthly.
STRIPE_PRICE_BASIC_MONTHLY=price_your_basic_monthly_id
# Price ID for Family Basic, annual.
STRIPE_PRICE_BASIC_ANNUAL=price_your_basic_annual_id
# Price ID for Family+, monthly.
STRIPE_PRICE_PLUS_MONTHLY=price_your_plus_monthly_id
# Price ID for Family+, annual.
STRIPE_PRICE_PLUS_ANNUAL=price_your_plus_annual_id
# Legacy single-product price IDs (optional) — used as a fallback for Basic if
# the per-tier vars above aren't set, so existing subscriptions keep working.
# Legacy monthly price ID.
STRIPE_PRICE_FAMILY_MONTHLY=price_your_legacy_monthly_id
# Legacy annual price ID.
STRIPE_PRICE_FAMILY_ANNUAL=price_your_legacy_annual_id

# ---- AI ----
# [secret] OpenAI key. Most AI features run on OpenAI. A key saved in Admin →
# AI Engine is preferred where lib/ai/settings.ts is consulted, but several
# readers use ONLY this variable and ignore the admin-saved key: chore-proof
# validation (lib/chores/ai.ts), the system health check (lib/server/health.ts),
# Guardian screening (lib/guardian/ai-screen.ts) and scam analysis
# (lib/guardian/scam-ai.ts). Set it here even if the admin key is saved.
OPENAI_API_KEY=sk-...
# [secret] Anthropic key. When set, Guardian screening
# (lib/guardian/ai-screen.ts) and scam analysis (lib/guardian/scam-ai.ts) call
# Anthropic FIRST and use OpenAI only when it is unset. Nothing else calls it.
ANTHROPIC_API_KEY=
# Optional model override (defaults to gpt-4o). Must be an OpenAI model.
AI_MODEL=gpt-4o
# Per-task model overrides, named AI_MODEL_<TASK> (taskEnvVar in
# lib/ai/routing.ts). Each is tried before the admin setting and the task's
# default model; a model that lacks what the task needs is skipped.
# AI_MODEL_CLASSIFY=
# AI_MODEL_EXTRACT=
# AI_MODEL_PLAN=
# AI_MODEL_REASON=
# AI_MODEL_SUMMARIZE=
# AI_MODEL_TRANSFORM=
# AI_MODEL_VISION=
# Speech-to-text model for "talk to AI" (defaults to whisper-1).
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Text-to-speech model for "AI speaks back" (defaults to gpt-4o-mini-tts).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Default TTS voice, used only when a request names no voice. The web client
# always sends one (lib/hooks/use-voice.ts starts at DEFAULT_TTS_VOICE), so in
# the shipped app this setting currently has no effect.
OPENAI_TTS_VOICE=nova
# Embedding model for marketing search (defaults to text-embedding-3-small).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Email (Resend) ----
# [secret] API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Verified sender. Must be an address on a domain you've verified in Resend
# (https://resend.com/domains). For quick testing use: Bubaly <onboarding@resend.dev>
EMAIL_FROM=Bubaly <notifications@yourdomain.com>
# Inbox that receives website contact-form submissions. Unset, the route
# silently uses the production support address hard-coded in
# app/api/contact/route.ts, with no log: set it on every preview and
# self-hosted deployment or their contact mail reaches production support.
CONTACT_INBOX=hello@yourdomain.com
# [secret] Shared secret guarding the internal welcome-email endpoint, and the
# first-choice key (before SUPABASE_SERVICE_ROLE_KEY) for rate-limit buckets,
# App Lock and network noise. Most readers
# refuse this placeholder (configuredSecret), but the network-aggregate noise
# key (lib/network/aggregate-server.ts) accepts any non-blank value. Replace it.
INTERNAL_SECRET=generate_a_random_string
# [secret] Resend webhook signing secret (whsec_...) — required to record
# marketing email opens/clicks/bounces. Create at https://resend.com/webhooks →
# endpoint /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
# [secret] Optional: dedicated secret for signing marketing unsubscribe links
# (falls back to INTERNAL_SECRET). Generate: openssl rand -hex 32
MARKETING_UNSUB_SECRET=

# ---- Guardian / SMS and voice (Twilio, optional) ----
# Twilio account SID. Guardian's Twilio features need all three of these
# (isTwilioConfigured in lib/guardian/twilio.ts).
TWILIO_ACCOUNT_SID=
# [secret] Twilio auth token. It also verifies the signature on every
# Twilio-facing webhook (lib/server/twilio-ingress.ts): unset, those webhooks
# answer 503 in every mode except the NODE_ENV=test fixture described below.
TWILIO_AUTH_TOKEN=
# The Twilio number Guardian sends from.
TWILIO_PHONE_NUMBER=

# Leave this UNSET everywhere except a local machine.
#
# Every Twilio-facing webhook (Guardian inbound SMS/voice/WhatsApp, screening,
# voicemail status, escalation TwiML, and the Contact Center's voice and SMS
# callbacks) is on the middleware PUBLIC allowlist: the caller is Twilio, not a
# signed-in person, so the request signature is the only thing standing between
# those endpoints and anyone at all. lib/server/twilio-ingress.ts therefore
# verifies on every request, in every environment, and refuses with 503 when
# TWILIO_AUTH_TOKEN is absent and it cannot verify at all.
#
# Unsigned fixtures require NODE_ENV=test and this flag set to 1, with
# TWILIO_AUTH_TOKEN unset. A configured token always requires a valid signature.
# Production, development and unset modes refuse unverifiable callbacks even
# if this fixture flag is copied into their environment.
ALLOW_UNSIGNED_TWILIO_WEBHOOKS=

# ---- Google OAuth (Sign-in + Calendar sync) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs: https://your-project-ref.supabase.co/auth/v1/callback
#   and https://www.bubaly.com/api/google/calendar/callback
#
# Full production setup — which client owns which flow, what to register where,
# and the consent-screen publishing status that gates all of it:
#   docs/runbooks/google-oauth-production.md
# Check a filled-in environment before deploying it: `npm run verify:oauth`.
#
# NEVER assign an empty value to any variable in this file. Absent falls back;
# blank defeats the fallback. Delete the line instead of blanking it.
# Optional. If set, this OUTRANKS everything and is sent to Google verbatim as
# the calendar redirect_uri — no path appended, no validation. Leave unset
# unless the registered URI differs from the app's own origin.
# GOOGLE_CALENDAR_REDIRECT_URI=
# Read-only calendar OAuth client id. Unset, Calendar connect redirects back
# with gcal=not_configured (app/api/google/calendar/auth/route.ts).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# [secret] Secret of the same client. Note: the admin social pages count this
# GOOGLE_CLIENT_ID/SECRET pair as YouTube credentials (lib/social/capabilities.ts),
# so YouTube shows "configured" whenever calendar OAuth is set up.
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---- Sync Platform ----
# [secret] 32-byte symmetric key that encrypts provider OAuth tokens before they
# touch the database (AES-256-GCM, lib/sync/crypto.ts). Fail-closed: unset or
# too short, loadKey() throws and no account can be connected; feed-token
# signing (lib/sync/feed-token.ts) also refuses without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TOKEN_KEY=

# Apple / iCloud calendar sync (CalDAV). OFF unless exactly "true"
# (lib/sync/providers/apple.ts): with it unset the Apple provider is simply
# absent and no network call fires. Calendar-only: reminders (VTODO) are not
# synced. Credentials are an Apple ID plus an app-specific password entered per
# account, not a global secret.
APPLE_SYNC_ENABLED=
# Optional CalDAV host override; defaults to https://caldav.icloud.com. Set
# only to point at a test server.
# APPLE_CALDAV_BASE_URL=

# Google two-way sync (Calendar events + Tasks). Use a DEDICATED OAuth client,
# separate from the login/read-only GOOGLE_* pair above, and register the
# redirect URI on that client.
# Dedicated sync client id. Unset or blank falls back to GOOGLE_CLIENT_ID
# (lib/sync/providers/google.ts uses `||`, so a blank line does not break the
# fallback). Leave commented to use the GOOGLE_* pair.
# GOOGLE_SYNC_CLIENT_ID=
# [secret] Dedicated sync client secret; falls back to GOOGLE_CLIENT_SECRET the same way.
# GOOGLE_SYNC_CLIENT_SECRET=
# Redirect for the sync client; defaults to <origin>/api/sync/google/callback.
GOOGLE_SYNC_REDIRECT_URI=https://www.bubaly.com/api/sync/google/callback
# Scopes (space-separated within each). Least-privilege: events read/write +
# calendar list read + tasks. openid+email are always added for the account email.
GOOGLE_SYNC_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
# Calendar-list read scope.
GOOGLE_SYNC_CALENDAR_READONLY_SCOPE=https://www.googleapis.com/auth/calendar.readonly
# Tasks scope.
GOOGLE_SYNC_TASKS_SCOPES=https://www.googleapis.com/auth/tasks

# Microsoft Graph two-way sync (Outlook Calendar + Microsoft To Do).
# Register an app at https://entra.microsoft.com → App registrations.
# Redirect URI (must match EXACTLY): https://www.bubaly.com/api/sync/microsoft/callback
# Entra application (client) id; the provider is off while it is unset.
MICROSOFT_SYNC_CLIENT_ID=
# [secret] Entra client secret.
MICROSOFT_SYNC_CLIENT_SECRET=
# Tenant for the authority URL; defaults to common.
MICROSOFT_SYNC_TENANT=common
# Optional override; defaults to <origin>/api/sync/microsoft/callback
# Must be the canonical custom domain, and must match the Entra registration
# EXACTLY. Never leave this present-but-blank: the code now falls back when it
# is empty, but a blank value in a hosting dashboard is still a trap worth not
# setting. Either give it this value or remove the variable entirely.
MICROSOFT_SYNC_REDIRECT_URI=https://www.bubaly.com/api/sync/microsoft/callback
# Scope override; unset or blank uses the adapter's default scopes.
MICROSOFT_SYNC_SCOPES=

# ---- Social: X (Twitter) OAuth 2.0 ----
# OAuth 2.0 with PKCE and a confidential client, so BOTH are required — the
# token exchange sends them as HTTP Basic. Register the app at
# https://developer.x.com and add the redirect URI EXACTLY as the app derives
# it: <NEXT_PUBLIC_APP_URL>/api/social/x/callback. SYNC_TOKEN_KEY above must
# also be a 32-byte key (64 hex characters or 44 base64): requireXConfiguration()
# (lib/social/x-oauth.ts) reports "setup required" when any of the three is missing.
# X app client id.
X_CLIENT_ID=
# [secret] X app client secret; server-side only.
X_CLIENT_SECRET=

# ---- Social: other providers (presence only) ----
# The admin social pages show a provider as "configured" when every name in its
# credentialEnv list is set (lib/social/capabilities.ts). Only X has a connector
# (lib/social/providers/x.ts); nothing else reads these values, so setting them
# changes a badge and connects nothing.
# Facebook and Instagram app id.
# FACEBOOK_APP_ID=
# [secret] Facebook and Instagram app secret.
# FACEBOOK_APP_SECRET=
# LinkedIn client id.
# LINKEDIN_CLIENT_ID=
# [secret] LinkedIn client secret.
# LINKEDIN_CLIENT_SECRET=
# TikTok client key.
# TIKTOK_CLIENT_KEY=
# [secret] TikTok client secret.
# TIKTOK_CLIENT_SECRET=
# Pinterest app id.
# PINTEREST_APP_ID=
# [secret] Pinterest app secret.
# PINTEREST_APP_SECRET=
# Threads app id.
# THREADS_APP_ID=
# [secret] Threads app secret.
# THREADS_APP_SECRET=
# Reddit client id.
# REDDIT_CLIENT_ID=
# [secret] Reddit client secret.
# REDDIT_CLIENT_SECRET=

# ---- Feedback -> GitHub bot (optional) ----
# Files each submitted idea as an issue, then reflects the issue's state back
# onto the idea's status and digests changes to the super admin. Driven by
# /api/cron/feedback-github-sync, scheduled daily in vercel.json.
# DARK until both a token and a repo are set (lib/integrations/github.ts):
# the cron still runs, does nothing, and reports nothing. A repo must be in
# "owner/name" form or it is treated as unconfigured. Use a fine-grained token
# limited to Issues (read/write) on that one repository.
# [secret] Token; checked first. GITHUB_FEEDBACK_TOKEN is the fallback.
# GITHUB_TOKEN=
# [secret] Fallback token name.
# GITHUB_FEEDBACK_TOKEN=
# Repository, "owner/name"; checked first. GITHUB_REPO is the fallback.
# GITHUB_FEEDBACK_REPO=owner/repo
# Fallback repository name.
# GITHUB_REPO=owner/repo

# ---- Optional content and event providers ----
# [secret] Giphy key; GIF search answers 503 without it.
GIPHY_API_KEY=
# [secret] Ticketmaster key; weekend discovery skips Ticketmaster without it.
TICKETMASTER_API_KEY=
# SeatGeek client id; weekend discovery skips SeatGeek without it.
SEATGEEK_CLIENT_ID=
# [secret] TheMealDB key; unset or blank uses the literal "1" in
# lib/recipes/providers/themealdb.ts.
THEMEALDB_API_KEY=
# [secret] Search Console OAuth ACCESS TOKEN, despite the name: the sync
# (lib/marketing/provider-sync.ts) accepts it only when it starts with "ya29."
# and ignores any other value. The admin marketing settings tile reads only
# this variable and shows "ready" for any non-empty value.
GOOGLE_SEARCH_CONSOLE_KEY=
# [secret] Search Console OAuth access token; the sync prefers it over
# GOOGLE_SEARCH_CONSOLE_KEY. The admin readiness tile does not look at it.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
# [secret] Bing Webmaster key for marketing sync.
BING_WEBMASTER_API_KEY=
# AI-citation provider endpoint; the sync needs both this and the key.
AI_CITATION_API_URL=
# [secret] AI-citation provider key.
AI_CITATION_API_KEY=

# ---- Voice assistants ----
# The Alexa skill's application id, from the Alexa developer console
# (amzn1.ask.skill.<uuid>). /api/assistant/alexa always verifies Amazon's
# request signature; this additionally pins the requests to OUR skill. Amazon
# signs any skill's requests, so without it somebody else's skill could name
# our endpoint and its signature would be genuine. Leave blank only before the
# skill exists — the setup docs and the Assistants page both say to set it.
ALEXA_SKILL_ID=

# ---- Contact center (inbound email) ----
# [secret] Shared secret the inbound-email provider (SendGrid Inbound Parse,
# Cloudflare Email Routing, Mailgun) must present when it POSTs each message for
# a family's @bubaly.com address to /api/contact-center/email: in the
# `x-inbound-secret` header, as the password of Basic credentials, or (logged
# with a warning) a `?key=` query parameter. FAIL-CLOSED IN EVERY BUILD: with
# this unset the endpoint rejects EVERY inbound message with 401, silently, and
# nothing in the UI says why (app/api/contact-center/email/route.ts). NODE_ENV
# does not change this. Prefer the header — a query parameter is written into
# access logs. Generate: openssl rand -hex 32. Setup and MX routing:
#   docs/runbooks/family-contact-center-routing.md
CONTACT_CENTER_INBOUND_SECRET=

# ---- Vercel Cron ----
# [secret] Random secret used to authenticate Vercel's cron pings — generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Health detail (optional) ----
# [secret] Bearer a trusted uptime monitor presents to GET /api/health for the
# detailed report (the names of unset feature secrets, probe error text,
# latency). Without it, or without the header, the public body carries only the
# status, the time and one boolean per check. Generate: openssl rand -hex 32
HEALTH_MONITOR_SECRET=

# ---- Claude fleet organization preflight (off by default) ----
# Leave disabled until each alias is bound to an expected Anthropic organization
# UUID and a separate server-only Admin API credential outside source control.
# A matching organization does not establish a connected Claude Code worker.
CLAUDE_FLEET_PROBES_ENABLED=false
# JSON array of non-secret {alias, expectedOrganizationId} objects (1-8 entries).
# Alias example: SyntheticAccount; expectedOrganizationId must be a UUID.
# CLAUDE_FLEET_ACCOUNT_BINDINGS=
# [secret] For each alias, uppercase it and replace hyphens with underscores to
# derive its server-only Admin API credential variable
# (ANTHROPIC_ADMIN_API_KEY__<ALIAS>, lib/claude-fleet/config.ts). Never put a
# key value in the JSON. Example name for SyntheticAccount (leave blank here):
# ANTHROPIC_ADMIN_API_KEY__SYNTHETICACCOUNT=

# ---- Durable Claude fleet worker (off; requires explicit paid-probe approval) ----
# Uses the existing /api/cron/claude-fleet schedule and an authenticated POST
# manager surface at that path.
# Enables the worker.
CLAUDE_FLEET_WORKERS_ENABLED=false
# Explicit approval for paid probes.
CLAUDE_FLEET_PAID_PROBES_APPROVED=false
# [secret] Manager secret. Separate secret: never reuse CRON_SECRET.
# CLAUDE_FLEET_MANAGER_SECRET=
# CLI-only endpoint read by scripts/claude-fleet.mjs; HTTPS, no
# credentials/query/fragment. The server does not read it.
# CLAUDE_FLEET_MANAGER_URL=https://www.bubaly.com/api/cron/claude-fleet
# Remote libSQL primary only. Never use a Vercel local SQLite file/replica.
# Explicit schema setup creates a PAUSED fleet. Runtime routes never run DDL.
# CLAUDE_FLEET_DATABASE_URL=libsql://your-fleet-database.turso.io
# [secret] libSQL auth token.
# CLAUDE_FLEET_DATABASE_AUTH_TOKEN=
# One binding for every account above: exact alias, branch label, full commit
# SHA and unique reviewed snapshot containing Claude Code + repository.
# Secrets do not belong in this JSON. Use distinct server API credentials.
# CLAUDE_FLEET_WORKER_BINDINGS=[{"alias":"SyntheticAccount","branch":"fleet/probe","revision":"0000000000000000000000000000000000000000","snapshotId":"snap_synthetic","workspaceId":"wrkspc_synthetic"}]
# [secret] Worker verifies THIS execution credential's organization; an
# Admin-key preflight does not verify a different model execution key. Name:
# ANTHROPIC_API_KEY__<ALIAS> (lib/claude-fleet/runtime-config.ts).
# ANTHROPIC_API_KEY__SYNTHETICACCOUNT=
# Defaults: two global slots, one slot per alias; eight is the hard global cap.
CLAUDE_FLEET_MAX_CONCURRENCY=2
# Each dispatched probe reserves $0.05, retained after cancellation/uncertainty.
# Reservations bound admissions; reconcile provider and Sandbox bills separately.
CLAUDE_FLEET_DAILY_BUDGET_USD=0.25

# ---- Admin digest delivery engine (off by default) ----
# "1" sends /api/cron/admin-digest through the per-recipient delivery engine
# (one digest per super admin per scheduled slot); any other value keeps the
# current route (lib/admin/digest-engine-route.ts). Leave it unset until
# migrations 0471 and 0474 are applied and verified in this environment; see
# docs/admin-digest-route-integration.md §6 for the gates.
# ADMIN_DIGEST_DELIVERY_ENGINE=1

# ---- Push / Mobile ----
# Web Push (installed PWA) uses VAPID keys. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the browser; the PRIVATE key stays server-only.
# VAPID public key (browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [secret] VAPID private key.
VAPID_PRIVATE_KEY=
# VAPID subject; unset or blank uses a mailto: support address in lib/server/push.ts.
VAPID_SUBJECT=mailto:hello@bubaly.com

# Android native push uses FCM HTTP v1 with an authorized service account.
# The legacy FCM_SERVER_KEY endpoint is retired; no code reads that name.
# Keep all private keys server-only. PEM values may contain literal \n escapes.
# Firebase project id; must match /^[a-z][a-z0-9-]{4,62}$/ or Android push
# reports unconfigured (lib/server/native-push.ts).
FCM_PROJECT_ID=
# Service-account client email; must look like an address (one @, no spaces).
FCM_CLIENT_EMAIL=
# [secret] Service-account private key (PEM).
FCM_PRIVATE_KEY=

# Capacitor on iOS registers an APNs device token, which is sent directly to APNs.
# Use a matching Apple Push Notifications .p8 key, team/key IDs and app bundle ID.
# Each check below is in apnsConfig() (lib/server/native-push.ts); if any fails,
# iOS push reports unconfigured.
# Apple team id: exactly 10 characters, A-Z and 0-9.
APNS_TEAM_ID=
# APNs key id: exactly 10 characters, A-Z and 0-9.
APNS_KEY_ID=
# [secret] The .p8 key contents (PEM).
APNS_PRIVATE_KEY=
# Bundle id. The code has NO fallback: it must be set, and must match
# /^[A-Za-z0-9][A-Za-z0-9.-]{0,254}$/. The value below is the appId in
# capacitor.config.ts.
APNS_TOPIC=com.bubaly.bubaly
# Match the provisioning profile: "production" or "sandbox". Unset or blank
# means production; any other spelling disables iOS push.
APNS_ENVIRONMENT=production

# Capacitor native shells load this hosted URL at build time
# (capacitor.config.ts; unset or blank means https://www.bubaly.com). Point at
# a LAN dev server (e.g. http://192.168.1.20:3000) for on-device development.
CAP_SERVER_URL=https://www.bubaly.com

# ---- Set by the build: do not set these by hand ----
# Written at build time by next.config.mjs from VERCEL_GIT_COMMIT_SHA (empty
# when that is unset) and served by /api/build-info, which is how a deploy is
# confirmed to carry a given commit.
# BUBALY_BUILD_REVISION=
# Optional label the display-mode error screen shows when
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA is absent; unset shows "dev"
# (app/(app)/display/error.tsx). Nothing else reads it.
# NEXT_PUBLIC_BUILD_ID=

# ---- Set by the platform — do not set by hand ----
# Read by the app but provided by Node, Next.js or Vercel. Listed so a reader of
# this file knows they exist and where they come from; setting them manually
# changes behaviour in ways the app does not expect.
#   NODE_ENV                           — Next.js. Selects development fallbacks
#                                        and diagnostics. It does NOT gate
#                                        webhook signature checks: Twilio and
#                                        inbound-email verification run in every
#                                        mode; only the unsigned Twilio test
#                                        fixture needs NODE_ENV=test
#   NEXT_RUNTIME                       — Next.js ("nodejs" | "edge")
#   TZ                                 — not read by app code; the app computes
#                                        family-local times explicitly. The test
#                                        configs default it to UTC
#   VERCEL_ENV, VERCEL_REGION          — Vercel. VERCEL_ENV=production also
#                                        refuses the AI provider stub
#   VERCEL_GIT_COMMIT_SHA,
#   NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA  — Vercel, per deployment

# ---- Test-only variables (never use production credentials) ----
# Port the local e2e runner serves on (scripts/run-e2e.mjs).
PLAYWRIGHT_PORT=3107
# "1" runs the signed-in e2e specs (tests/e2e/authenticated.spec.ts).
E2E_AUTHENTICATED=0
# Account the signed-in e2e specs use.
E2E_AUTH_EMAIL=bubaly-e2e@example.test
# [secret] Password for that account; also the persona seed's fallback password.
E2E_AUTH_PASSWORD=use-a-local-test-password
# "1" lets scripts/seed-personas.mjs seed a non-loopback Supabase; it refuses
# any remote host otherwise.
E2E_ALLOW_REMOTE_SUPABASE=0
# [secret] Persona password for scripts/seed-personas.mjs; falls back to
# E2E_AUTH_PASSWORD, and the script stops when neither is set.
# E2E_PERSONA_PASSWORD=
# Email domain for seeded personas; defaults to example.test.
# E2E_PERSONA_DOMAIN=example.test
# "1" skips the build step in scripts/run-e2e.mjs.
# PLAYWRIGHT_SKIP_BUILD=1
# Chromium binary for Playwright (playwright.config.ts and the audit scripts),
# for sandboxes without Playwright's own browser build.
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
# Scripted AI provider (lib/ai/provider-stub.ts). OFF unless exactly "1", and
# never on a Vercel production deployment (VERCEL_ENV=production). Under
# NODE_ENV=production it also needs E2E_PROVIDER_STUB=1 plus CI or a localhost
# Supabase URL. Warns once per process when enabled.
# AI_PROVIDER_STUB=1
# "1" opts a production-mode e2e build into the stub; honoured only with CI set
# or a localhost NEXT_PUBLIC_SUPABASE_URL, and never when VERCEL_ENV=production.
# E2E_PROVIDER_STUB=1
# Directory of scripted AI responses for the stub (defaults to
# tests/ai-eval/scripts). Never set in a real deployment.
# AI_PROVIDER_STUB_DIR=tests/ai-eval/scripts

# ---- Operator and developer scripts (optional; never read by the app) ----
# Base URL for scripts/audit-live-pages.mjs (default https://www.bubaly.com)
# and the local crawlers scripts/crawl-login.mjs and
# scripts/crawl-authenticated-routes.mjs (default http://127.0.0.1:3000).
# BASE_URL=http://127.0.0.1:3000
# Sign-in for scripts/crawl-login.mjs, which exits when either is unset. Use a
# local test account, never a real person's.
# TEST_EMAIL=
# [secret] Password for that local test account.
# TEST_PASSWORD=
# Session cookie file for scripts/crawl-authenticated-routes.mjs (default
# cookies.json, git-ignored). It holds a live session cookie: keep it local
# and delete it after the crawl.
# COOKIE_FILE=cookies.json
# Chromium binary for scripts/crawl-login.mjs, launched with --no-sandbox.
# CHROMIUM_PATH=
# Chromium binary for scripts/axe-audit.mjs and scripts/page-audit.mjs.
# PAGE_AUDIT_CHROMIUM=
# Chromium binary for scripts/page-audit-crawl.mjs and page-audit-session.mjs.
# PLAYWRIGHT_CHROMIUM=
# scripts/page-audit/crawl.mjs: target origin (default https://www.bubaly.com).
# BASE=
# scripts/page-audit/crawl.mjs: comma-separated viewports (default phone,desktop).
# VIEWPORTS=phone,desktop
# scripts/page-audit/crawl.mjs: any value appends to the output file.
# APPEND=
# scripts/page-audit/crawl.mjs: any value skips the axe scan.
# NO_AXE=
# scripts/page-audit/crawl.mjs: Playwright storage-state file for a signed-in crawl.
# STORAGE_STATE=
# scripts/page-audit/crawl.mjs: extra Chromium arguments, space-separated.
# CHROMIUM_ARGS=
# "1" keeps the fixture directory scripts/verify-app-lock-rsc.mjs creates.
# KEEP_APP_LOCK_RSC_FIXTURE=1
# psql binary for scripts/verify-notification-key-migration.mjs (default psql).
# PSQL_BIN=psql
# Admin database for that script (default postgres).
# PGADMIN_DATABASE=postgres
# Anon key the schema and marketing-access audits accept as a fallback
# (scripts/audit-supabase-schema.mjs, scripts/verify-marketing-public-access.mjs).
# The app reads NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# SUPABASE_ANON_KEY=
# Publishable key the CI diagnostic scripts/probe-supabase-rest.mjs tries; the
# app reads NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [secret] Secret key the same diagnostic tries; the app never reads it.
# SUPABASE_SECRET_KEY=
# [secret] Supabase management token for the migration-state audit and the
# release scripts (scripts/audit-production-migration-state.mjs,
# scripts/apply-production-forward-release.mjs); CI passes it from a secret.
# SUPABASE_ACCESS_TOKEN=
# Project ref those scripts target.
# SUPABASE_PROJECT_REF=
# Origin scripts/cron-dispatch.mjs sends the CRON_SECRET bearer to. Unset or
# blank means https://www.bubaly.com. It must be https (plain http only for
# localhost) with no credentials, query or path, or the dispatch refuses.
# CRON_BASE_URL=
