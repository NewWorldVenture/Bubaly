# ============================================================
# Bubaly — Environment Variables Reference
# Copy to .env.local and fill in your values.
# DO NOT commit .env.local — and never put real secrets in this file.
# This is a template only; every value below is a placeholder.
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Legacy seed scripts (explicitly non-production) ----
# Required by scripts/seed*.mjs. These scripts use the service role and may
# mutate family-scoped records; production is intentionally rejected.
SEED_ENVIRONMENT=local
SEED_FAMILY_ID=00000000-0000-4000-8000-000000000000
SEED_CONFIRM_FAMILY_ID=00000000-0000-4000-8000-000000000000
SEED_CREATED_BY_USER_ID=00000000-0000-4000-8000-000000000000

# ---- App URL ----
# Both must be the CANONICAL custom domain in production (https://www.bubaly.com),
# never the generated *.vercel.app alias: that alias is tied to the Vercel project
# NAME and is released whenever the project is renamed. NEXT_PUBLIC_APP_URL is the
# base for OAuth callbacks, Twilio webhooks, and billing return URLs, so pointing
# it at an alias makes those break on the next rename.
NEXT_PUBLIC_APP_URL=https://www.bubaly.com
NEXT_PUBLIC_SITE_URL=https://www.bubaly.com

# ---- Access and optional platform features ----
SUPER_ADMIN_EMAILS=
CHILD_LOGIN_SECRET=generate_a_random_string
GUARDIAN_INTERNAL_SECRET=generate_a_random_string

# ---- Stripe ----
# Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_publishable_key
# Webhook secret: https://dashboard.stripe.com/webhooks (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Bubaly Money (Issuing/Treasury/Connect) webhook — SEPARATE endpoint from billing:
# point a second Stripe webhook at /api/webhooks/money and put its secret here.
# Falls back to STRIPE_WEBHOOK_SECRET if unset. Required for real-time card
# authorizations (issuing_authorization.request) once Issuing is enabled.
STRIPE_MONEY_WEBHOOK_SECRET=

# Stripe price IDs per tier (USD): Family Basic $12.04/mo or $119.88/yr;
# Family+ $30.11/mo or $299.88/yr. Annual billing is equivalent to $9.99/mo
# or $24.99/mo respectively (about 17% less than paying monthly).
# Current live IDs and rollout status: docs/runbooks/family-pricing.md.
# Test environments must use matching test-mode prices; do not copy live secrets.
STRIPE_PRICE_BASIC_MONTHLY=price_your_basic_monthly_id
STRIPE_PRICE_BASIC_ANNUAL=price_your_basic_annual_id
STRIPE_PRICE_PLUS_MONTHLY=price_your_plus_monthly_id
STRIPE_PRICE_PLUS_ANNUAL=price_your_plus_annual_id
# Legacy single-product price IDs (optional) — used as a fallback for Basic if
# the per-tier vars above aren't set, so existing subscriptions keep working.
STRIPE_PRICE_FAMILY_MONTHLY=price_your_legacy_monthly_id
STRIPE_PRICE_FAMILY_ANNUAL=price_your_legacy_annual_id

# ---- AI (OpenAI / ChatGPT only) ----
# Every AI feature runs on OpenAI. Set your key here (or in Admin → AI Engine).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
# Optional model override (defaults to gpt-4o). Must be an OpenAI model.
AI_MODEL=gpt-4o
# Voice assistant (optional overrides — all use the same OPENAI_API_KEY).
# Speech-to-text model for "talk to AI" (defaults to whisper-1).
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Text-to-speech model + default voice for "AI speaks back".
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# ---- Email (Resend) ----
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Verified sender. Must be an address on a domain you've verified in Resend
# (https://resend.com/domains). For quick testing use: Bubaly <onboarding@resend.dev>
EMAIL_FROM=Bubaly <notifications@yourdomain.com>
# Inbox that receives website contact-form submissions
CONTACT_INBOX=hello@yourdomain.com
# Shared secret guarding the internal welcome-email endpoint (any random string)
INTERNAL_SECRET=generate_a_random_string
# Resend webhook signing secret (whsec_...) — required to record marketing email
# opens/clicks/bounces. Create at https://resend.com/webhooks → endpoint /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
# Optional: dedicated secret for signing marketing unsubscribe links
# (falls back to INTERNAL_SECRET). Generate: openssl rand -hex 32
MARKETING_UNSUB_SECRET=

# ---- Guardian / SMS and voice (Twilio, optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_CALLER_NUMBER=

# ---- Google OAuth (Sign-in + Calendar sync) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs: https://your-project-ref.supabase.co/auth/v1/callback
#   and https://www.bubaly.com/api/google/calendar/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---- Sync Platform ----
# 32-byte symmetric key that encrypts provider OAuth tokens before they touch the
# database (AES-256-GCM, see lib/sync/crypto.ts). REQUIRED to connect any account —
# without it, token storage fails closed rather than persisting plaintext.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TOKEN_KEY=

# Google two-way sync (Calendar events + Tasks). Use a DEDICATED OAuth client,
# separate from the login/read-only GOOGLE_* pair above. Register the redirect
# URI on that client in the Google console. Falls back to GOOGLE_CLIENT_ID/SECRET
# and an origin-derived redirect if these are unset.
GOOGLE_SYNC_CLIENT_ID=
GOOGLE_SYNC_CLIENT_SECRET=
GOOGLE_SYNC_REDIRECT_URI=https://www.bubaly.com/api/sync/google/callback
# Scopes (space-separated within each). Least-privilege: events read/write +
# calendar list read + tasks. openid+email are always added for the account email.
GOOGLE_SYNC_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
GOOGLE_SYNC_CALENDAR_READONLY_SCOPE=https://www.googleapis.com/auth/calendar.readonly
GOOGLE_SYNC_TASKS_SCOPES=https://www.googleapis.com/auth/tasks

# Microsoft Graph two-way sync (Outlook Calendar + Microsoft To Do).
# Register an app at https://entra.microsoft.com → App registrations.
# Redirect URI (must match EXACTLY): https://www.bubaly.com/api/sync/microsoft/callback
# These are the variables the sync adapter actually reads (lib/sync/providers/microsoft.ts):
MICROSOFT_SYNC_CLIENT_ID=
MICROSOFT_SYNC_CLIENT_SECRET=
MICROSOFT_SYNC_TENANT=common
# Optional override; defaults to <origin>/api/sync/microsoft/callback
MICROSOFT_SYNC_REDIRECT_URI=
MICROSOFT_SYNC_SCOPES=

# ---- Optional content and event providers ----
GIPHY_API_KEY=
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
THEMEALDB_API_KEY=
GOOGLE_SEARCH_CONSOLE_KEY=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
BING_WEBMASTER_API_KEY=
AI_CITATION_API_URL=
AI_CITATION_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Test-only variables (never use production credentials) ----
PLAYWRIGHT_PORT=3107
E2E_AUTHENTICATED=0
E2E_AUTH_EMAIL=bubaly-e2e@example.test
E2E_AUTH_PASSWORD=use-a-local-test-password
E2E_ALLOW_REMOTE_SUPABASE=0

# ---- Vercel Cron ----
# Random secret used to authenticate Vercel's cron pings — generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Push / Mobile ----
# Web Push (installed PWA) uses VAPID keys. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the browser; the PRIVATE key stays server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bubaly.com

# Android native push uses FCM HTTP v1 with an authorized service account.
# The legacy FCM_SERVER_KEY endpoint is retired and is no longer used.
# Keep all private keys server-only. PEM values may contain literal \n escapes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Capacitor on iOS registers an APNs device token, which is sent directly to APNs.
# Use a matching Apple Push Notifications .p8 key, team/key IDs and app bundle ID.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.bubaly.bubaly
# Match the provisioning profile: production (default) or sandbox.
APNS_ENVIRONMENT=production

# Capacitor native shells load this hosted URL (defaults to production). Point at
# a LAN dev server (e.g. http://192.168.1.20:3000) for on-device development.
CAP_SERVER_URL=https://www.bubaly.com
