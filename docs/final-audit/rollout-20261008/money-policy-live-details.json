  "helpers": [
    {
      "name": "can_manage_family",
      "definition": "CREATE OR REPLACE FUNCTION public.can_manage_family(p_family_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1 from public.family_members\n    where family_id = p_family_id and user_id = auth.uid()\n      and role in ('parent','adult') and is_active\n  );\n$function$\n"
    },
    {
      "name": "is_family_member",
      "definition": "CREATE OR REPLACE FUNCTION public.is_family_member(p_family_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1 from public.family_members\n    where family_id = p_family_id and user_id = auth.uid() and is_active\n  );\n$function$\n"
    }
  ],
