# Copy to mobile/.env (git-ignored). EXPO_PUBLIC_* values are inlined into the app.
# They are public by construction: never put a secret in an EXPO_PUBLIC_* variable.
# Supabase project URL (mobile/src/lib/config.ts). With it or the anon key
# unset, isSupabaseConfigured() is false.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key for the same project.
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# The hosted web app (serves /api/ai). Point at a LAN dev server for local work.
# Unset falls back to extra.apiUrl in mobile/app.json, then https://www.bubaly.com,
# the intended production default.
EXPO_PUBLIC_API_URL=https://www.bubaly.com
