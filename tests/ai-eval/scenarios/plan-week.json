{
  "id": "plan-week",
  "prompt": "Plan our week",
  "intent": "plan_week",
  "outcome": "plan",
  "requiredTools": [
    "calendar.searchEvents",
    "calendar.findConflicts",
    "meals.planWeek",
    "groceries.addFromMealPlan",
    "tasks.createTodo",
